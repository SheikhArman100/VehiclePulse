{
  "name": "@vehicle-pulse/telemetry-service",
  "version": "1.0.0",
  "private": true,
  "description": "VehiclePulse - Telemetry ingestion microservice",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "node --watch --loader ts-node/esm src/server.ts",
    "test": "node --test --import ts-node/register/esm src/**/*.test.ts",
    "clean": "node -e \"const fs=require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive:true, force:true});\""
  },
  "dependencies": {
    "@vehicle-pulse/config": "*",
    "@vehicle-pulse/event-contracts": "*",
    "@vehicle-pulse/logger": "*",
    "@vehicle-pulse/shared": "*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
