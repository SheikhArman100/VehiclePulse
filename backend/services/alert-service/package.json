{
  "name": "@vehicle-pulse/alert-service",
  "version": "1.0.0",
  "private": true,
  "description": "VehiclePulse - Real-time alerts, rules engine, and incident management microservice",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "build": "prisma generate && tsc",
    "type-check": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "node --watch --loader ts-node/esm src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test": "node --test dist/**/*.test.js",
    "clean": "node -e \"const fs=require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive:true, force:true});\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "@vehicle-pulse/config": "*",
    "@vehicle-pulse/event-contracts": "*",
    "@vehicle-pulse/logger": "*",
    "@vehicle-pulse/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.12.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@prisma/config": "7.10.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "7.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
