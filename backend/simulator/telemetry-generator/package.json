{
  "name": "@vehicle-pulse/telemetry-generator",
  "version": "1.0.0",
  "private": true,
  "description": "VehiclePulse - Stateful vehicle telemetry simulator CLI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "telemetry-sim": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "test": "node --test dist/**/*.test.js",
    "clean": "node -e \"const fs=require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive:true, force:true});\""
  },
  "dependencies": {
    "@vehicle-pulse/config": "*",
    "@vehicle-pulse/event-contracts": "*",
    "@vehicle-pulse/logger": "*",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
