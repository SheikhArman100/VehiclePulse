{
  "name": "@vehicle-pulse/logger",
  "version": "1.0.0",
  "private": true,
  "description": "VehiclePulse - Shared structured logger using Pino with correlation ID support",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "clean": "node -e \"const fs=require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive:true, force:true});\""
  },
  "dependencies": {
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.3"
  }
}
