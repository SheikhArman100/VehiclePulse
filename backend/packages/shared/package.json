{
  "name": "@vehicle-pulse/shared",
  "version": "1.0.0",
  "private": true,
  "description": "VehiclePulse - Shared middleware, errors, correlation ID, and health check patterns",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
