{
  "name": "@vehicle-pulse/event-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "VehiclePulse - Shared event contracts, envelope schema, domain definitions, and Zod validators",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
